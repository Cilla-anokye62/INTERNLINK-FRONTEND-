# During local Expo development, the computer address is detected from Metro.
EXPO_PUBLIC_API_PORT=8081

# Set a complete HTTPS URL for preview/production builds.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Preview APKs can tolerate the first wake-up of a sleeping Render Free backend.
# Normal requests return to the standard 15-second timeout after any response.
# EXPO_PUBLIC_API_COLD_START_TIMEOUT_MS=75000

# Public OAuth client ID of type "Web application". This is not a secret.
# Required in development/APK builds for Google Sign-In.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# EAS project UUID. Public identifier used when requesting Expo push tokens.
# EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Expo account/project owner used by EAS Build.
# EXPO_OWNER=your-expo-username

# Native Firebase configuration paths. In EAS these can be secret file variables.
# Required for remote push notifications in native builds.
# GOOGLE_SERVICES_JSON=./google-services.json
# GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist

# Reversed iOS OAuth client ID, for example:
# com.googleusercontent.apps.000000000000-example
# GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.000000000000-example

# INTERNLINK_RELEASE_BUILD is set by eas.json. Do not set it for Expo Go;
# it makes preview/production configuration fail fast when required values
# above are missing.
